APP_NAME=SafetyLog
APP_ENV=production
APP_KEY=base64:fv94sBMayW+UxgMkhVRfg+uloWx+gwEvAC1IwNT8Pp0=
APP_DEBUG=false
APP_URL=https://api.safetylog.web.id
FRONTEND_URL=https://safetylog.web.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Kunci rahasia untuk eksekusi migrasi & seeding database via browser:
APP_SETUP_KEY=SafetyLogSetup2026!

# --- KONEKSI DATABASE MYSQL CPANEL ---
# Sesuaikan DB_DATABASE, DB_USERNAME, dan DB_PASSWORD dengan yang dibuat di cPanel MySQL Databases:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_cpanel_database
DB_USERNAME=nama_cpanel_user
DB_PASSWORD=password_database_anda

# Penyimpanan Sesi, Cache, dan Antrean di Database MySQL
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.safetylog.web.id

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Keamanan Multi-Tenant & Domain Cross-Origin
SANCTUM_STATEFUL_DOMAINS=safetylog.web.id
CORS_ALLOWED_ORIGINS=https://safetylog.web.id
CORS_SUPPORTS_CREDENTIALS=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error
